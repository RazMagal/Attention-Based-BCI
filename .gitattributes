# Normalize all text files to LF in the repo, auto-detect text vs binary.
# This is what kills the CRLF/LF churn (your 85-file "phantom" diff).
* text=auto eol=lf

# Explicit text types
*.py   text eol=lf
*.sh   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.cfg  text eol=lf

# Windows batch files must stay CRLF
*.bat  text eol=crlf

# Binary — never diff or normalize
*.h5     binary
*.hdf5   binary
*.ckpt   binary
*.pb     binary
*.mat    binary
*.npy    binary
*.npz    binary
*.pkl    binary
*.pickle binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
